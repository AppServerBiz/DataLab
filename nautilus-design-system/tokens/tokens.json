{
  "name": "Nautilus Quant Design System",
  "version": "1.0.0",
  "theme": "dark-quant",
  "colors": {
    "background": {
      "main": "#0B0E14",
      "card": "#181C25",
      "cardHover": "#1E232F",
      "surface": "#121620",
      "toolbar": "#13171F"
    },
    "text": {
      "main": "#E2E8F0",
      "muted": "#64748B",
      "heading": "#FFFFFF",
      "inverse": "#000000"
    },
    "accents": {
      "cyan": "#38BDF8",
      "cyanHover": "#7DD3FC",
      "profit": "#22C55E",
      "profitSoft": "rgba(34, 197, 94, 0.15)",
      "loss": "#EF4444",
      "lossSoft": "rgba(239, 68, 68, 0.15)",
      "warning": "#F59E0B",
      "purple": "#A855F7"
    },
    "border": {
      "subtle": "rgba(255, 255, 255, 0.05)",
      "medium": "rgba(255, 255, 255, 0.08)",
      "strong": "rgba(255, 255, 255, 0.15)",
      "active": "#38BDF8"
    },
    "palette": {
      "robots": [
        "#38BDF8",
        "#22C55E",
        "#F59E0B",
        "#EF4444",
        "#A855F7",
        "#EC4899",
        "#06B6D4",
        "#84CC16",
        "#F97316",
        "#6366F1",
        "#0EA5E9",
        "#10B981",
        "#D946EF",
        "#F43F5E",
        "#8B5CF6"
      ],
      "benchmarks": {
        "portfolio": "#38BDF8",
        "ibov": "#F59E0B",
        "cdi": "#22C55E",
        "sp500": "#A855F7"
      }
    }
  },
  "typography": {
    "fonts": {
      "main": "'JetBrains Mono', monospace",
      "header": "'Michroma', sans-serif",
      "sans": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
    },
    "sizes": {
      "badge": "0.65rem",
      "caption": "0.75rem",
      "sm": "0.85rem",
      "base": "0.95rem",
      "h3": "1.1rem",
      "h2": "1.35rem",
      "h1": "1.75rem",
      "kpi": "2rem"
    },
    "weights": {
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "letterSpacing": {
      "dense": "-0.5px",
      "normal": "0",
      "wide": "1px",
      "spaced": "2px",
      "tag": "4px"
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "xxl": "32px"
  },
  "radii": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "20px",
    "pill": "9999px"
  },
  "shadows": {
    "card": "0 4px 20px rgba(0, 0, 0, 0.25)",
    "glowCyan": "0 0 15px rgba(56, 189, 248, 0.4)",
    "glowProfit": "0 0 15px rgba(34, 197, 94, 0.3)",
    "glowLoss": "0 0 15px rgba(239, 68, 68, 0.3)",
    "modal": "0 24px 80px rgba(0, 0, 0, 0.6)"
  }
}
